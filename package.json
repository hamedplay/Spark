{
  "name": "meeting-manager",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
    "build": "node node_modules/typescript/bin/tsc && node node_modules/vite/bin/vite.js build",
    "lint": "node node_modules/eslint/bin/eslint.js . --max-warnings 0",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "clean-test-data": "node scripts/clean-test-data.js",
    "set-admin": "node scripts/set-admin.js",
    "test:layout-presence": "node --import tsx --test tests/app/layoutPresenceLifecycle.test.ts",
    "test:recurrence": "node --import tsx --test tests/meetings/buildRecurringMeetingRecords.test.ts",
    "test:meeting-record": "node --import tsx --test tests/meetings/buildMeetingPersistenceRecord.test.ts",
    "test:calendar-url": "node --import tsx --test tests/meetings/buildGoogleCalendarEventUrl.test.ts",
    "test:meeting-prefill": "node --import tsx --test tests/meetings/buildMeetingEditPrefill.test.ts",
    "test:layout-navigation": "node --import tsx --test tests/app/layoutNavigation.test.ts",
    "test:user-preferences-mapping": "node --import tsx --test tests/user-preferences/userPreferencesMapping.test.ts",
    "test:user-preferences-lifecycle": "node --import tsx --test tests/user-preferences/userPreferencesLifecycle.test.ts",
    "test:notification-model": "node --import tsx --test tests/notifications/notificationModel.test.ts",
    "test:notification-lifecycle": "node --import tsx --test tests/notifications/notificationBellLifecycle.test.ts",
    "test:notification-producer-model": "node --import tsx --test tests/notifications/notificationProducerModel.test.ts",
    "test:notification-template-cache": "node --import tsx --test tests/notifications/notificationTemplateCache.test.ts",
    "test:notification-producer": "node --import tsx --test tests/notifications/notificationProducer.test.ts",
    "test:minutes-access": "node --import tsx --test tests/minutes/minutesMeetingAccess.test.ts",
    "test:minutes-prefill": "node --import tsx --test tests/minutes/minutesPrefill.test.ts",
    "test:minutes-decisions": "node --import tsx --test tests/minutes/decisionsConversion.test.ts",
    "test:approval-mode": "node --import tsx --test tests/minutes/approvalMode.test.ts",
    "test:minutes-integration": "node --import tsx --test tests/minutes/minutesIntegrationContract.test.ts",
    "test:minutes-entry-button": "node --import tsx --test tests/minutes/minutesEntryButton.test.ts",
    "test:minutes-create-submit": "node --import tsx --test tests/minutes/minutesCreateSubmitFlow.test.ts",
    "test:minutes-entry-flow": "node --import tsx --test tests/minutes/minutesEntryFlow.test.ts",
    "test:minutes-participants": "node --import tsx --test tests/minutes/minutesParticipants.test.ts",
    "test:minutes-date": "node --import tsx --test tests/minutes/minutesDate.test.ts",
    "test": "npm run test:recurrence && npm run test:meeting-record && npm run test:calendar-url && npm run test:meeting-prefill && npm run test:layout-navigation && npm run test:layout-presence && npm run test:user-preferences-mapping && npm run test:user-preferences-lifecycle && npm run test:notification-model && npm run test:notification-lifecycle && npm run test:notification-producer-model && npm run test:notification-template-cache && npm run test:notification-producer && npm run test:minutes-access && npm run test:minutes-prefill && npm run test:minutes-decisions && npm run test:approval-mode && npm run test:minutes-integration && npm run test:minutes-entry-button && npm run test:minutes-create-submit && npm run test:minutes-entry-flow && npm run test:minutes-participants && npm run test:minutes-date"
  },
  "dependencies": {
    "@react-oauth/google": "^0.13.5",
    "@supabase/supabase-js": "2.110.2",
    "@types/react-datepicker": "^6.2.0",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "html-to-image": "^1.11.11",
    "lucide-react": "1.24.0",
    "moment": "^2.30.1",
    "moment-jalaali": "^0.10.0",
    "node-fetch": "^3.3.2",
    "peerjs": "^1.5.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.4.1",
    "simple-peer": "^9.11.1",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/moment-jalaali": "^0.7.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/simple-peer": "^9.11.8",
    "@typescript-eslint/eslint-plugin": "8.63.0",
    "@typescript-eslint/parser": "8.63.0",
    "@vitejs/plugin-react": "6.0.3",
    "autoprefixer": "^10.4.17",
    "dotenv": "^17.4.2",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
