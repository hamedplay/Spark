# Spark LiveKit self-hosted stack
# Copy to .env on the LiveKit host. Never commit real secrets.

LIVEKIT_DOMAIN=meet.shahrmeeting.ir
LIVEKIT_TURN_DOMAIN=turn.shahrmeeting.ir
LIVEKIT_INGRESS_DOMAIN=ingress.shahrmeeting.ir
LIVEKIT_API_KEY=replace-with-long-random-api-key
LIVEKIT_API_SECRET=replace-with-long-random-api-secret
LIVEKIT_WEBHOOK_URL=https://api.shahrmeeting.ir/functions/v1/livekit-webhook

# Recording / Egress storage is local to the LiveKit host through MinIO.
# Spark Manager generates the credentials; MinIO is bound to loopback only.
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
S3_REGION=us-east-1
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=spark-conference-recordings


# Phase 23 deployment tuning. The defaults fit the initial 20-participant
# single-node topology and can be raised or externalized without code changes.
LIVEKIT_REDIS_ADDRESS=127.0.0.1:6379
LIVEKIT_CPU_LIMIT=4.0
LIVEKIT_MEMORY_LIMIT=4g
LIVEKIT_STOP_GRACE_PERIOD=5h
EGRESS_CPU_LIMIT=4.0
EGRESS_MEMORY_LIMIT=4g
EGRESS_STOP_GRACE_PERIOD=15m
INGRESS_CPU_LIMIT=2.0
INGRESS_MEMORY_LIMIT=2g
INGRESS_STOP_GRACE_PERIOD=2m
REDIS_CPU_LIMIT=0.5
REDIS_MEMORY_LIMIT=512m
MINIO_CPU_LIMIT=1.0
MINIO_MEMORY_LIMIT=1g
CADDY_CPU_LIMIT=0.5
CADDY_MEMORY_LIMIT=256m

# Images are intentionally pinned. Review release notes before upgrades.
LIVEKIT_SERVER_IMAGE=livekit/livekit-server:v1.13.5
LIVEKIT_EGRESS_IMAGE=livekit/egress:v1.13.0
LIVEKIT_INGRESS_IMAGE=livekit/ingress:v1.5.0
REDIS_IMAGE=redis:7.4.5-alpine
CADDY_IMAGE=caddy:2.10.2-alpine
MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-08-13T08-35-41Z


# Phase 22 observability. All HTTP UIs are bound to 127.0.0.1 only.
PROMETHEUS_IMAGE=prom/prometheus:v3.14.0
ALERTMANAGER_IMAGE=prom/alertmanager:v0.34.0
GRAFANA_IMAGE=grafana/grafana:13.2.0
LOKI_IMAGE=grafana/loki:3.7.0
ALLOY_IMAGE=grafana/alloy:v1.19.0
NODE_EXPORTER_IMAGE=prom/node-exporter:v1.12.1
BLACKBOX_EXPORTER_IMAGE=prom/blackbox-exporter:v0.28.0
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-me

PROMETHEUS_CPU_LIMIT=1.0
PROMETHEUS_MEMORY_LIMIT=1g
ALERTMANAGER_CPU_LIMIT=0.25
ALERTMANAGER_MEMORY_LIMIT=256m
LOKI_CPU_LIMIT=1.0
LOKI_MEMORY_LIMIT=1g
ALLOY_CPU_LIMIT=0.5
ALLOY_MEMORY_LIMIT=512m
NODE_EXPORTER_CPU_LIMIT=0.25
NODE_EXPORTER_MEMORY_LIMIT=256m
BLACKBOX_CPU_LIMIT=0.25
BLACKBOX_MEMORY_LIMIT=128m
GRAFANA_CPU_LIMIT=0.5
GRAFANA_MEMORY_LIMIT=512m
