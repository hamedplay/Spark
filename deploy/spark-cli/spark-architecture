#!/usr/bin/env python3
from __future__ import annotations

import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
if str(HERE) not in sys.path:
    sys.path.insert(0, str(HERE))

from architecture.controller import run_action
from architecture.cli import main as cli_main


def backend(action_id: str) -> int:
    result = run_action(action_id)
    print(result.title)
    print("=" * len(result.title))
    for line in result.lines:
        print(line)
    return 0 if result.success else 1


def main(argv: list[str]) -> int:
    if len(argv) >= 2 and argv[0] == "--backend-action":
        return backend(argv[1])
    return cli_main(argv)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
