  printf '%s%s' "$C_GREEN" "$C_BOLD"
  cat <<'ART'
   ███████╗██████╗  █████╗ ██████╗ ██╗  ██╗
   ██╔════╝██╔══██╗██╔══██╗██╔══██╗██║ ██╔╝
   ███████╗██████╔╝███████║██████╔╝█████╔╝
   ╚════██║██╔═══╝ ██╔══██║██╔══██╗██╔═██╗
   ███████║██║     ██║  ██║██║  ██║██║  ██╗
   ╚══════╝╚═╝     ╚═╝  ╚═╝╚═╝  ╚═╝╚═╝  ╚═╝
ART
  printf '%s\n' "$C_RESET"
  printf '%s%sWelcome to Spark Server Manager%s\n' "$C_BOLD" "$C_CYAN" "$C_RESET"
  printf '%sProduction deployment, operations and infrastructure control for Spark.%s\n' "$C_DIM" "$C_RESET"
  printf '%sValidation-first workflows · production-aware defaults · detailed logs%s\n\n' "$C_DIM" "$C_RESET"
  printf '%sManager:%s v%s   %sHost:%s %s\n' \
    "$C_DIM" "$C_RESET" "$SPARK_MANAGER_VERSION" "$C_DIM" "$C_RESET" "$(hostname -s 2>/dev/null || hostname)"
  printf '%sRepository:%s github.com/hamedplay/Spark\n\n' "$C_DIM" "$C_RESET"
