  BACKTITLE="⚡ SPARK · INSTALLATION · $(hostname -s 2>/dev/null || hostname)"
  export BACKTITLE
  TUI_PERSISTENT_FILTERS=true
  export TUI_PERSISTENT_FILTERS

  local config rc
  config="$(spark_tui_install_config)"
  set +e +u
  TUI_MODE="fullscreen" mainmenu \
    "SPARK INSTALLATION" \
    "Guided single-host deployment · completed steps are tracked automatically" \
    "$config" 1
  rc=$?
  set -Eeuo pipefail
  return 0
}

spark_tui_pick() {
  local title_text="$1" message="$2" default_index="$3"
  shift 3
  local result rc
  set +e +u
  result="$(TUI_MODE="fullscreen" menu "$title_text" "$message" "$default_index" "$@")"
  rc=$?
  set -Eeuo pipefail
  (( rc == 0 )) || return "$rc"
  printf '%s' "$result"
}

test_menu() {
  spark_tui_init || return 1
  spark_tui_extra_keys
  local choice
  while true; do
    BACKTITLE="⚡ SPARK · HEALTH & LOGS"
    export BACKTITLE
    choice="$(spark_tui_pick "HEALTH CHECKS & LOGS" \
      "Navigate with arrows · Enter runs · q goes back" 1 \
      "01  Full Validation" \
      "02  Frontend" \
      "03  API / Auth / Functions" \
      "04  Docker Status" \
      "05  Docker Service Logs" \
      "06  Nginx Status & Logs" \
      "07  Scheduler Status & Logs" \
      "08  TURN Status & Logs" \
      "09  DB / API Exposure Check" \
      "10  DNS & TLS" \
      "11  Listening Ports & UFW" \
      "12  Migration Dry Run")" || return 0

    spark_plain_prepare
    case "${choice:0:2}" in
      01) new_log "test-full"; run_visible "Full validation" test_full_validation || true ;;
      02) new_log "test-frontend"; run_visible "Frontend" test_frontend || true ;;
      03) new_log "test-api"; run_visible "API" test_api || true ;;
      04) new_log "test-docker"; run_visible "Docker status" compose ps || true ;;
