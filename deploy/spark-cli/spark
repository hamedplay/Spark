#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'

SPARK_MANAGER_VERSION="1.2.0"
REPO_URL="https://github.com/hamedplay/Spark.git"
RAW_BASE="https://raw.githubusercontent.com/hamedplay/Spark/main/deploy/spark-cli"
SPARK_ROOT="/opt/spark"
SUPABASE_SOURCE="/opt/supabase-source"
SUPABASE_ROOT="/opt/spark-supabase"
CONFIG_DIR="/etc/spark"
MANAGER_CONF="${CONFIG_DIR}/manager.conf"
STATE_DIR="/var/lib/spark-manager"
STEP_DIR="${STATE_DIR}/steps"
LOG_DIR="/var/log/spark-manager"
BACKUP_DIR="/var/backups/spark"
CLI_PATH="/usr/local/bin/spark"

C_RESET=$'\033[0m'
C_GREEN=$'\033[32m'
C_RED=$'\033[31m'
C_YELLOW=$'\033[33m'
C_BLUE=$'\033[34m'
C_CYAN=$'\033[36m'
C_WHITE=$'\033[37m'
C_BOLD=$'\033[1m'
C_DIM=$'\033[2m'

CURRENT_LOG=""

if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
  exec sudo -E "$0" "$@"
fi

mkdir -p "$STATE_DIR" "$STEP_DIR" "$LOG_DIR" "$BACKUP_DIR" "$CONFIG_DIR"
chmod 700 "$STATE_DIR" "$STEP_DIR" "$LOG_DIR" "$BACKUP_DIR" "$CONFIG_DIR"

SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  SOURCE_DIR="$(cd -P -- "$(dirname -- "$SOURCE")" >/dev/null 2>&1 && pwd)"
  TARGET="$(readlink -- "$SOURCE")"
  if [[ "$TARGET" == /* ]]; then
    SOURCE="$TARGET"
  else
    SOURCE="${SOURCE_DIR}/${TARGET}"
  fi
done
SCRIPT_DIR="$(cd -P -- "$(dirname -- "$SOURCE")" >/dev/null 2>&1 && pwd)"
unset SOURCE SOURCE_DIR TARGET

for module in core install-base install-platform-a install-platform-b install-platform-c tests-backup update admin; do
  module_path="${SCRIPT_DIR}/lib/${module}.sh"
  if [[ ! -r "$module_path" ]]; then
    printf 'Spark Manager module missing: %s\n' "$module_path" >&2
    exit 1
  fi
  source "$module_path"
done
unset module module_path

# Presentation layer only. Operational modules remain unchanged.
pause() {
  printf '\n'
  read -r -p "Press Enter to continue..." _
}

confirm_word() {
  local message="$1" word="$2" answer
  printf '%s\n' "$message"
  read -r -p "Type ${word} to confirm: " answer
  [[ "$answer" == "$word" ]]
}

ui_refresh_dimensions() {
  local cols
  cols="$(tput cols 2>/dev/null || printf '80')"
  [[ "$cols" =~ ^[0-9]+$ ]] || cols=80
  UI_WIDTH="$cols"
  (( UI_WIDTH > 95 )) && UI_WIDTH=95
  (( UI_WIDTH < 41 )) && UI_WIDTH=41
  (( UI_WIDTH % 2 == 0 )) && ((UI_WIDTH--))
  UI_INNER=$((UI_WIDTH - 4))
  UI_LABEL_WIDTH=$(( (UI_WIDTH - 17) / 2 ))
  (( UI_LABEL_WIDTH < 8 )) && UI_LABEL_WIDTH=8
  return 0
}

ui_repeat() {
  local char="$1" count="$2" out
  printf -v out '%*s' "$count" ''
  out="${out// /$char}"
  printf '%s' "$out"
}

ui_top() {
  printf '%s┌' "$C_GREEN"
  ui_repeat '─' $((UI_WIDTH - 2))
  printf '┐%s\n' "$C_RESET"
}

ui_rule() {
  printf '%s├' "$C_GREEN"
  ui_repeat '─' $((UI_WIDTH - 2))
  printf '┤%s\n' "$C_RESET"
}

ui_bottom() {
  printf '%s└' "$C_GREEN"
  ui_repeat '─' $((UI_WIDTH - 2))
  printf '┘%s\n' "$C_RESET"
}

ui_row() {
  local text="$1" style="${2:-}" max pad
  max="$UI_INNER"
  (( ${#text} > max )) && text="${text:0:max}"
  pad=$((max - ${#text}))
  printf '%s│%s %s%s%s%*s %s│%s\n' \
    "$C_GREEN" "$C_RESET" "$style" "$text" "$C_RESET" "$pad" '' "$C_GREEN" "$C_RESET"
}

ui_center() {
  local text="$1" style="${2:-}" max left right
  max="$UI_INNER"
  (( ${#text} > max )) && text="${text:0:max}"
  left=$(( (max - ${#text}) / 2 ))
  right=$((max - ${#text} - left))
  printf '%s│%s %*s%s%s%s%*s %s│%s\n' \
    "$C_GREEN" "$C_RESET" "$left" '' "$style" "$text" "$C_RESET" "$right" '' "$C_GREEN" "$C_RESET"
}

ui_pair() {
  local key1="$1" label1="$2" key2="${3:-}" label2="${4:-}"
  local width="$UI_LABEL_WIDTH"
  label1="${label1:0:width}"
  label2="${label2:0:width}"
  if [[ -n "$key2" ]]; then
    printf '%s│%s %s[%2s]%s %s%-*s%s %s│%s %s[%2s]%s %s%-*s%s %s│%s\n' \
      "$C_GREEN" "$C_RESET" "$C_CYAN" "$key1" "$C_RESET" "$C_BOLD" "$width" "$label1" "$C_RESET" \
      "$C_GREEN" "$C_RESET" "$C_CYAN" "$key2" "$C_RESET" "$C_BOLD" "$width" "$label2" "$C_RESET" \
      "$C_GREEN" "$C_RESET"
  else
    printf '%s│%s %s[%2s]%s %s%-*s%s %s│%s %*s %s│%s\n' \
      "$C_GREEN" "$C_RESET" "$C_CYAN" "$key1" "$C_RESET" "$C_BOLD" "$width" "$label1" "$C_RESET" \
      "$C_GREEN" "$C_RESET" $((width + 5)) '' "$C_GREEN" "$C_RESET"
  fi
}

ui_step_pair() {
  local step1="$1" label1="$2" step2="$3" label2="$4"
  local width=$((UI_LABEL_WIDTH - 2)) icon1='·' icon2='·' style1="$C_DIM" style2="$C_DIM"
  [[ -f "${STEP_DIR}/${step1}.ok" ]] && { icon1='✓'; style1="$C_GREEN"; }
  [[ -f "${STEP_DIR}/${step2}.ok" ]] && { icon2='✓'; style2="$C_GREEN"; }
  (( width < 6 )) && width=6
  label1="${label1:0:width}"
  label2="${label2:0:width}"
  printf '%s│%s %s[%2s]%s %s%s%s %s%-*s%s %s│%s %s[%2s]%s %s%s%s %s%-*s%s %s│%s\n' \
    "$C_GREEN" "$C_RESET" "$C_CYAN" "$step1" "$C_RESET" "$style1" "$icon1" "$C_RESET" "$C_BOLD" "$width" "$label1" "$C_RESET" \
    "$C_GREEN" "$C_RESET" "$C_CYAN" "$step2" "$C_RESET" "$style2" "$icon2" "$C_RESET" "$C_BOLD" "$width" "$label2" "$C_RESET" \
    "$C_GREEN" "$C_RESET"
}

ui_screen_start() {
  local heading="$1" subtitle="${2:-}"
  ui_refresh_dimensions
  clear_screen
  ui_top
  ui_center "$heading" "$C_BOLD$C_CYAN"
  [[ -n "$subtitle" ]] && ui_center "$subtitle" "$C_DIM"
  ui_rule
}

ui_read_choice() {
  local __var="$1" hint="${2:-Select an option}"
  local answer
  ui_rule
  ui_row "$hint" "$C_DIM"
  ui_row "Select:"
  ui_bottom
  if [[ -t 0 && -t 1 ]]; then
    printf '\033[2A\033[10C'
    read -r answer
  else
    read -r -p 'Select: ' answer
  fi
  printf -v "$__var" '%s' "$answer"
}

menu_section() {
  ui_row "▸ $1" "$C_BOLD$C_GREEN"
}

menu_option() {
  ui_pair "$1" "$2"
}

menu_option_status() {
  local key="$1" badge="$2" label="$3"
  ui_row "[$key] $badge $label"
}

menu_hint() {
  ui_row "$1" "$C_DIM"
}

title() {
  local host
  host="$(hostname -s 2>/dev/null || hostname)"
  ui_screen_start "SPARK SERVER MANAGER" "Host: ${host}  |  Version: ${SPARK_MANAGER_VERSION}"
  ui_bottom
}

welcome_screen() {
  ui_refresh_dimensions
  clear_screen
  ui_top
  ui_center '  ____  ____   _    ____  _  __' "$C_BOLD$C_GREEN"
  ui_center ' / ___||  _ \ / \  |  _ \| |/ /' "$C_BOLD$C_GREEN"
  ui_center ' \___ \| |_) / _ \ | |_) |   < ' "$C_BOLD$C_GREEN"
  ui_center '  ___) |  __/ ___ \|  _ <| |\ \' "$C_BOLD$C_GREEN"
  ui_center ' |____/|_| /_/   \_\_| \_\_| \_\' "$C_BOLD$C_GREEN"
  ui_center 'Welcome to Spark Server Manager' "$C_BOLD$C_CYAN"
  ui_rule
}

main_menu() {
  while true; do
    welcome_screen
    ui_pair "1" "Install / Configure" "2" "Health Checks & Logs"
    ui_pair "3" "Update Spark" "4" "Update Linux Packages"
    ui_pair "5" "Node / npm / Audit" "6" "Open Supabase Admin"
    ui_pair "7" "Close Supabase Admin" "8" "Resource Monitor"
    ui_pair "9" "Backup Management" "10" "Service Management"
    ui_pair "11" "TLS Certificates" "12" "Version & Security"
    ui_pair "13" "Update Spark Manager" "0" "Exit"
    ui_read_choice choice "Production infrastructure control | v${SPARK_MANAGER_VERSION}"
    case "$choice" in
      0) clear_screen; exit 0 ;;
      1) install_menu ;;
      2) test_menu ;;
      3) update_spark || true; pause ;;
      4) linux_update || true; pause ;;
      5) npm_menu ;;
      6) open_supabase_admin_access || true; pause ;;
      7) close_supabase_admin_access || true; pause ;;
      8) resource_status; pause ;;
      9) backup_menu ;;
      10) service_menu ;;
      11) certificate_menu ;;
      12) version_info; pause ;;
      13) self_update || true; pause ;;
      *) fail "Invalid option"; sleep 1 ;;
    esac
  done
}

install_menu() {
  while true; do
    ui_screen_start "SINGLE-HOST INSTALLATION" "Completed steps are marked with green checks"
    ui_step_pair "1" "DNS verification" "2" "Install configuration"
    ui_step_pair "3" "Packages / Docker / Node" "4" "Spark repository"
    ui_step_pair "5" "Pinned Supabase source" "6" "Supabase secrets"
    ui_step_pair "7" "Supabase environment" "8" "Edge Functions sync"
    ui_step_pair "9" "Provider / worker env" "10" "Compose hardening"
    ui_step_pair "11" "Start Supabase" "12" "Database migrations"
    ui_step_pair "13" "Frontend deployment" "14" "Nginx bootstrap"
    ui_step_pair "15" "TLS certificates" "16" "Production Nginx"
    ui_step_pair "17" "Local schedulers" "18" "TURN / Coturn"
    ui_step_pair "19" "Certbot renewal hook" "20" "Production firewall"
    ui_pair "21" "Run all steps 1-20" "0" "Back"
    ui_read_choice choice "Workflow: deploy/manual-production/single-host.md"
    case "$choice" in
      0) return ;;
      [1-9]|1[0-9]|20) run_install_step "$choice" || true; pause ;;
      21) run_all_install || true; pause ;;
      *) fail "Invalid option"; sleep 1 ;;
    esac
  done
}

docker_logs_menu() {
  new_log "logs-docker"
  if [[ ! -f "${SUPABASE_ROOT}/docker-compose.yml" ]]; then
    fail "Supabase compose file was not found."
    pause
    return
  fi
  local services choice service i left right
  mapfile -t services < <(compose config --services)
  while true; do
    ui_screen_start "DOCKER SERVICE LOGS" "Select a service to display its last 200 log lines"
    for ((i=0; i<${#services[@]}; i+=2)); do
      left=$((i + 1))
      right=$((i + 2))
      if (( i + 1 < ${#services[@]} )); then
        ui_pair "$left" "${services[i]}" "$right" "${services[i+1]}"
      else
        ui_pair "$left" "${services[i]}" "0" "Back"
      fi
    done
    if (( ${#services[@]} % 2 == 0 )); then
      ui_pair "0" "Back"
    fi
    ui_read_choice choice "Choose a service number"
    [[ "$choice" == "0" ]] && return
    [[ "$choice" =~ ^[0-9]+$ ]] || { fail "Invalid option"; sleep 1; continue; }
    (( choice >= 1 && choice <= ${#services[@]} )) || { fail "Invalid option"; sleep 1; continue; }
    service="${services[choice-1]}"
    run_report "Logs: ${service}" compose logs --tail=200 --timestamps "$service"
    pause
    return
  done
}

test_menu() {
  while true; do
    ui_screen_start "HEALTH CHECKS & LOGS" "Validation, diagnostics and runtime visibility"
    ui_pair "1" "Full Validation" "2" "Frontend"
    ui_pair "3" "API / Auth / Functions" "4" "Docker Status"
    ui_pair "5" "Docker Service Logs" "6" "Nginx Status & Logs"
    ui_pair "7" "Scheduler Status & Logs" "8" "TURN Status & Logs"
    ui_pair "9" "DB / API Exposure" "10" "DNS & TLS"
    ui_pair "11" "Listening Ports & UFW" "12" "Migration Dry Run"
    ui_pair "0" "Back"
    ui_read_choice choice "Logs: /var/log/spark-manager/"
    case "$choice" in
      0) return ;;
      1) new_log "test-full"; run_visible "Full validation" test_full_validation || true; pause ;;
      2) new_log "test-frontend"; run_visible "Frontend" test_frontend || true; pause ;;
      3) new_log "test-api"; run_visible "API" test_api || true; pause ;;
      4) new_log "test-docker"; run_visible "Docker status" compose ps || true; pause ;;
      5) docker_logs_menu ;;
      6)
        new_log "test-nginx"
        run_report "Nginx status" systemctl status nginx --no-pager
        journalctl -u nginx -n 120 --no-pager 2>&1 | tee -a "$CURRENT_LOG" || true
        pause ;;
      7) new_log "test-schedulers"; run_report "Scheduler status" test_schedulers; scheduler_logs; pause ;;
      8)
        new_log "test-turn"
        run_report "TURN test" test_turn
        journalctl -u coturn -n 120 --no-pager 2>&1 | tee -a "$CURRENT_LOG" || true
        pause ;;
      9) new_log "test-exposure"; run_visible "Public exposure check" test_db_exposure || true; pause ;;
      10) new_log "test-dns-ssl"; run_visible "DNS/TLS" test_ssl_dns || true; pause ;;
      11)
        new_log "test-ports-firewall"
        run_report "Listening ports" ss -lntup
        run_report "UFW" ufw status verbose
        pause ;;
      12) new_log "test-migration-dryrun"; run_visible "Migration dry-run" migration_dry_run "$SPARK_ROOT" || true; pause ;;
      *) fail "Invalid option"; sleep 1 ;;
    esac
  done
}

backup_menu() {
  while true; do
    ui_screen_start "BACKUP MANAGEMENT" "Database and production configuration backups"
    ui_pair "1" "Create Manual Backup" "2" "List Backups"
    ui_pair "0" "Back"
    ui_read_choice c "Backups are stored under ${BACKUP_DIR}"
    case "$c" in
      0) return ;;
      1)
        new_log "backup-manual"
        if run_visible "Create backup" create_backup manual; then ok "Backup created successfully."; fi
        pause ;;
      2) new_log "backup-list"; run_report "Backups" list_backups; pause ;;
      *) fail "Invalid option"; sleep 1 ;;
    esac
  done
}

npm_menu() {
  while true; do
    ui_screen_start "NODE.JS / NPM / AUDIT" "Dependency maintenance without automatic source mutation"
    ui_pair "1" "Show Versions" "2" "Update npm"
    ui_pair "3" "Install Dependencies" "4" "Full npm Audit"
    ui_pair "5" "Production npm Audit" "6" "Outdated Packages"
    ui_pair "7" "Audit Fix Dry Run" "0" "Back"
    ui_read_choice c "npm audit fix remains dry-run only"
    new_log "npm-maintenance"
    case "$c" in
      0) return ;;
      1) run_report "Versions" bash -c 'node --version; npm --version'; pause ;;
      2) run_visible "Update npm" npm install -g 'npm@^11.6.2' || true; pause ;;
      3) run_visible "npm ci" bash -c "cd '$SPARK_ROOT' && npm ci" || true; pause ;;
      4) run_report "npm audit" bash -c "cd '$SPARK_ROOT' && npm audit"; pause ;;
      5) run_report "npm audit production" bash -c "cd '$SPARK_ROOT' && npm audit --omit=dev"; pause ;;
      6) run_report "npm outdated" bash -c "cd '$SPARK_ROOT' && npm outdated"; pause ;;
      7) run_report "npm audit fix dry-run" bash -c "cd '$SPARK_ROOT' && npm audit fix --dry-run"; pause ;;
      *) fail "Invalid option"; sleep 1 ;;
    esac
  done
}

service_menu() {
  while true; do
    ui_screen_start "SERVICE MANAGEMENT" "Controlled service status, restart and reload operations"
    ui_pair "1" "Show Service Status" "2" "Restart Functions + Worker"
    ui_pair "3" "Reload Nginx" "4" "Restart Coturn"
    ui_pair "5" "Restart Supabase Stack" "6" "Restart Scheduler Timers"
    ui_pair "0" "Back"
    ui_read_choice c "Potentially disruptive actions still require confirmation"
    new_log "service-management"
    case "$c" in
      0) return ;;
      1)
        run_report "Nginx" systemctl status nginx --no-pager
        run_report "Coturn" systemctl status coturn --no-pager
        run_report "Docker" compose ps
        run_report "Timers" systemctl list-timers 'spark-*' --no-pager
        pause ;;
      2) run_visible "Restart Functions + Worker" bash -c "cd '$SUPABASE_ROOT' && docker compose up -d --force-recreate functions avatar-worker" || true; pause ;;
      3) run_visible "Nginx test/reload" bash -c 'nginx -t && systemctl reload nginx' || true; pause ;;
      4) run_visible "Restart Coturn" systemctl restart coturn || true; pause ;;
      5)
        if confirm_word "The entire Supabase stack will be recreated and may cause a brief service interruption." "RESTART"; then
          run_visible "Restart Supabase stack" bash -c "cd '$SUPABASE_ROOT' && docker compose up -d --force-recreate" || true
        fi
        pause ;;
      6)
        run_visible "Restart timers" bash -c 'systemctl restart spark-daily-report.timer spark-minutes-reminder.timer spark-decision-due.timer spark-notification-outbox.timer' || true
        pause ;;
      *) fail "Invalid option"; sleep 1 ;;
    esac
  done
}

certificate_menu() {
  while true; do
    ui_screen_start "TLS CERTIFICATE MANAGEMENT" "Certbot certificate inspection and renewal"
    ui_pair "1" "Show Certificates" "2" "Renewal Dry Run"
    ui_pair "3" "Run Certbot Renew" "0" "Back"
    ui_read_choice c "Certificate operations use the existing production configuration"
    new_log "certificate-management"
    case "$c" in
      0) return ;;
      1) run_report "Certificates" certbot certificates; pause ;;
      2) run_visible "Renewal dry-run" certbot renew --dry-run || true; pause ;;
      3) run_visible "Certbot renew" certbot renew || true; pause ;;
      *) fail "Invalid option"; sleep 1 ;;
    esac
  done
}

case "${1:-}" in
  --version|-V)
    printf 'Spark Server Manager %s\n' "$SPARK_MANAGER_VERSION"
    exit 0
    ;;
  --help|-h)
    cat <<EOF
Usage: spark [option]

Run without an option to open the interactive control center.

  --version       Show Spark Manager version
  --test          Run full validation
  --update        Update Spark application
  --resources     Show server resource usage
EOF
    exit 0
    ;;
  --test)
    title
    new_log "cli-test"
    run_visible "Full validation" test_full_validation
    ;;
  --update)
    update_spark
    ;;
  --resources)
    resource_status
    ;;
  "")
    main_menu
    ;;
  *)
    fail "Unknown option: $1"
    exit 2
    ;;
esac
