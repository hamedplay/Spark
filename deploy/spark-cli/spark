#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'

SPARK_MANAGER_VERSION="1.3.0"
REPO_URL="https://github.com/hamedplay/Spark.git"
RAW_BASE="https://raw.githubusercontent.com/hamedplay/Spark/main/deploy/spark-cli"
SPARK_ROOT="/opt/spark"
SUPABASE_SOURCE="/opt/supabase-source"
SUPABASE_ROOT="/opt/spark-supabase"
CONFIG_DIR="/etc/spark"
MANAGER_CONF="${CONFIG_DIR}/manager.conf"
STATE_DIR="/var/lib/spark-manager"
STEP_DIR="${STATE_DIR}/steps"
LOG_DIR="/var/log/spark-manager"
BACKUP_DIR="/var/backups/spark"
CLI_PATH="/usr/local/bin/spark"

TUI_VENDOR_REF="52d8e84ce008531f25dfe8339ac9474e1d6feb49"
TUI_VENDOR_DIR="/usr/local/share/spark-manager"
TUI_VENDOR_FILE="${TUI_VENDOR_DIR}/terminal-menus.sh"
TUI_VENDOR_LICENSE="${TUI_VENDOR_DIR}/terminal-menus.LICENSE.md"
TUI_VENDOR_REF_FILE="${TUI_VENDOR_DIR}/terminal-menus.ref"
TUI_VENDOR_RAW="https://raw.githubusercontent.com/sc0ttj/terminal-menus.sh/${TUI_VENDOR_REF}"

C_RESET=$'\033[0m'
C_GREEN=$'\033[32m'
C_RED=$'\033[31m'
C_YELLOW=$'\033[33m'
C_BLUE=$'\033[34m'
C_CYAN=$'\033[36m'
C_WHITE=$'\033[37m'
C_BOLD=$'\033[1m'
C_DIM=$'\033[2m'

CURRENT_LOG=""
SPARK_TUI_READY=0
SPARK_TUI_STATE_DIR="${STATE_DIR}/tui"

if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
  exec sudo -E "$0" "$@"
fi

mkdir -p "$STATE_DIR" "$STEP_DIR" "$LOG_DIR" "$BACKUP_DIR" "$CONFIG_DIR" "$SPARK_TUI_STATE_DIR"
chmod 700 "$STATE_DIR" "$STEP_DIR" "$LOG_DIR" "$BACKUP_DIR" "$CONFIG_DIR" "$SPARK_TUI_STATE_DIR"

SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  SOURCE_DIR="$(cd -P -- "$(dirname -- "$SOURCE")" >/dev/null 2>&1 && pwd)"
  TARGET="$(readlink -- "$SOURCE")"
  if [[ "$TARGET" == /* ]]; then
    SOURCE="$TARGET"
  else
    SOURCE="${SOURCE_DIR}/${TARGET}"
  fi
done
SCRIPT_DIR="$(cd -P -- "$(dirname -- "$SOURCE")" >/dev/null 2>&1 && pwd)"
unset SOURCE SOURCE_DIR TARGET

for module in core install-base install-platform-a install-platform-b install-platform-c tests-backup update admin; do
  module_path="${SCRIPT_DIR}/lib/${module}.sh"
  if [[ ! -r "$module_path" ]]; then
    printf 'Spark Manager module missing: %s\n' "$module_path" >&2
    exit 1
  fi
  source "$module_path"
done
unset module module_path

pause() {
  printf '\n'
  read -r -p "Press Enter to continue..." _
}

confirm_word() {
  local message="$1" word="$2" answer
  printf '%s\n' "$message"
  read -r -p "Type ${word} to confirm: " answer
  [[ "$answer" == "$word" ]]
}

title() {
  clear_screen
  printf '%s%s SPARK SERVER MANAGER%s  %s· Production Infrastructure Control%s\n' \
    "$C_BOLD" "$C_GREEN" "$C_RESET" "$C_DIM" "$C_RESET"
  printf '%s%s%s\n' "$C_GREEN" "────────────────────────────────────────────────────────────────────────" "$C_RESET"
  printf '%sHost:%s %-24s %sVersion:%s %s\n\n' \
    "$C_DIM" "$C_RESET" "$(hostname -s 2>/dev/null || hostname)" \
    "$C_DIM" "$C_RESET" "$SPARK_MANAGER_VERSION"
}

ensure_tui_vendor() {
  local installed_ref=""
  if [[ -r "$TUI_VENDOR_REF_FILE" ]]; then
    installed_ref="$(tr -d '[:space:]' <"$TUI_VENDOR_REF_FILE")"
  fi
  if [[ -r "$TUI_VENDOR_FILE" && "$installed_ref" == "$TUI_VENDOR_REF" ]]; then
    return 0
  fi

  command -v curl >/dev/null 2>&1 || {
    fail "The terminal UI library is missing or outdated and curl is unavailable."
    info "Re-run the Spark Manager bootstrap installer."
    return 1
  }

  local tmp
  tmp="$(mktemp -d)"

  info "Installing pinned terminal UI library (${TUI_VENDOR_REF:0:12})..."
  if ! curl -fsSL "${TUI_VENDOR_RAW}/terminal-menus.sh" -o "${tmp}/terminal-menus.sh"; then
    rm -rf "$tmp"
    return 1
  fi
  if ! curl -fsSL "${TUI_VENDOR_RAW}/LICENSE.md" -o "${tmp}/LICENSE.md"; then
    rm -rf "$tmp"
    return 1
  fi
  if ! bash -n "${tmp}/terminal-menus.sh"; then
    rm -rf "$tmp"
    return 1
  fi
  if ! grep -q '^mainmenu()' "${tmp}/terminal-menus.sh"; then
    fail "Pinned terminal UI library does not expose mainmenu()."
    rm -rf "$tmp"
    return 1
  fi

  install -d -m 0755 "$TUI_VENDOR_DIR"
  install -m 0644 "${tmp}/terminal-menus.sh" "$TUI_VENDOR_FILE"
  install -m 0644 "${tmp}/LICENSE.md" "$TUI_VENDOR_LICENSE"
  printf '%s\n' "$TUI_VENDOR_REF" >"$TUI_VENDOR_REF_FILE"
  chmod 0644 "$TUI_VENDOR_REF_FILE"
  rm -rf "$tmp"
}

spark_tui_theme() {
  BG_MAIN="5;13;15"
  BG_WIDGET="13;29;31"
  BG_ACTIVE="0;176;150"
  HL_BLUE="$BG_ACTIVE"
  FG_TEXT="229;244;241"
  FG_HINT="112;151;148"
  FG_BACKTITLE="92;242;207"
  BG_BACKTITLE="7;21;23"
  BG_INPUT="3;9;11"
  FG_INPUT="92;242;207"
  BG_MODAL="17;35;37"
}

spark_tui_init() {
  local rc
  if (( SPARK_TUI_READY == 1 )); then
    spark_tui_theme
    set +e +u
    _init_tui
    rc=$?
    set -Eeuo pipefail
    return "$rc"
  fi

  ensure_tui_vendor || return 1
  spark_tui_theme

  set +e +u
  source "$TUI_VENDOR_FILE"
  rc=$?
  if (( rc == 0 )); then
    spark_tui_theme
    _init_tui
    rc=$?
  fi
  set -Eeuo pipefail
  (( rc == 0 )) || {
    fail "Unable to load terminal-menus.sh."
    return 1
  }

  SPARK_TUI_READY=1
}

