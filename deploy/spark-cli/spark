#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'

SPARK_MANAGER_VERSION="1.1.0"
REPO_URL="https://github.com/hamedplay/Spark.git"
RAW_BASE="https://raw.githubusercontent.com/hamedplay/Spark/main/deploy/spark-cli"
SPARK_ROOT="/opt/spark"
SUPABASE_SOURCE="/opt/supabase-source"
SUPABASE_ROOT="/opt/spark-supabase"
CONFIG_DIR="/etc/spark"
MANAGER_CONF="${CONFIG_DIR}/manager.conf"
STATE_DIR="/var/lib/spark-manager"
STEP_DIR="${STATE_DIR}/steps"
LOG_DIR="/var/log/spark-manager"
BACKUP_DIR="/var/backups/spark"
CLI_PATH="/usr/local/bin/spark"

C_RESET=$'\033[0m'
C_GREEN=$'\033[32m'
C_RED=$'\033[31m'
C_YELLOW=$'\033[33m'
C_BLUE=$'\033[34m'
C_CYAN=$'\033[36m'
C_WHITE=$'\033[37m'
C_BOLD=$'\033[1m'
C_DIM=$'\033[2m'

CURRENT_LOG=""

if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
  exec sudo -E "$0" "$@"
fi

mkdir -p "$STATE_DIR" "$STEP_DIR" "$LOG_DIR" "$BACKUP_DIR" "$CONFIG_DIR"
chmod 700 "$STATE_DIR" "$STEP_DIR" "$LOG_DIR" "$BACKUP_DIR" "$CONFIG_DIR"

SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  SOURCE_DIR="$(cd -P -- "$(dirname -- "$SOURCE")" >/dev/null 2>&1 && pwd)"
  TARGET="$(readlink -- "$SOURCE")"
  if [[ "$TARGET" == /* ]]; then
    SOURCE="$TARGET"
  else
    SOURCE="${SOURCE_DIR}/${TARGET}"
  fi
done
SCRIPT_DIR="$(cd -P -- "$(dirname -- "$SOURCE")" >/dev/null 2>&1 && pwd)"
unset SOURCE SOURCE_DIR TARGET

for module in core install-base install-platform-a install-platform-b install-platform-c tests-backup update admin; do
  module_path="${SCRIPT_DIR}/lib/${module}.sh"
  if [[ ! -r "$module_path" ]]; then
    printf 'Spark Manager module missing: %s\n' "$module_path" >&2
    exit 1
  fi
  source "$module_path"
done
unset module module_path

# Presentation layer only. Operational modules remain unchanged.
pause() {
  printf '\n'
  read -r -p "Press Enter to continue..." _
}

confirm_word() {
  local message="$1" word="$2" answer
  printf '%s\n' "$message"
  read -r -p "Type ${word} to confirm: " answer
  [[ "$answer" == "$word" ]]
}

menu_rule() {
  printf '%s%s%s\n' "$C_GREEN" "────────────────────────────────────────────────────────────────────────" "$C_RESET"
}

menu_section() {
  printf '\n%s%s▸ %s%s\n' "$C_BOLD" "$C_GREEN" "$1" "$C_RESET"
}

menu_option() {
  local key="$1" label="$2" detail="${3:-}"
  printf '  %s[%2s]%s  %s%-30s%s %s%s%s\n' \
    "$C_CYAN" "$key" "$C_RESET" "$C_BOLD" "$label" "$C_RESET" "$C_DIM" "$detail" "$C_RESET"
}

menu_option_status() {
  local key="$1" badge="$2" label="$3"
  printf '  %s[%2s]%s  %s %-44s\n' "$C_CYAN" "$key" "$C_RESET" "$badge" "$label"
}

menu_hint() {
  printf '\n  %s%s%s\n\n' "$C_DIM" "$1" "$C_RESET"
}

title() {
  clear_screen
  local host
  host="$(hostname -s 2>/dev/null || hostname)"
  printf '%s%s SPARK SERVER MANAGER%s  %s· Production Infrastructure Control%s\n' \
    "$C_BOLD" "$C_GREEN" "$C_RESET" "$C_DIM" "$C_RESET"
  menu_rule
  printf '%sHost:%s %-24s  %sVersion:%s %s\n' \
    "$C_DIM" "$C_RESET" "$host" "$C_DIM" "$C_RESET" "$SPARK_MANAGER_VERSION"
}

