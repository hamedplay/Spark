spark_tui_extra_keys() {
  TUI_EXTRA_KEYS=$'?=spark_tui_help'
  export TUI_EXTRA_KEYS
}

spark_tui_status_completed() {
  local count=0
  if [[ -d "$STEP_DIR" ]]; then
    count="$(find "$STEP_DIR" -maxdepth 1 -type f -name '*.ok' 2>/dev/null | wc -l | tr -d ' ')"
  fi
  [[ "$count" =~ ^[0-9]+$ ]] || count=0
  (( count > 20 )) && count=20
  printf '%s/20 complete' "$count"
}

spark_tui_admin_state() {
  if ss -lnt 2>/dev/null | grep -q ':8443 '; then
    printf 'OPEN'
  else
    printf 'CLOSED'
  fi
}

spark_tui_backup_state() {
  local count=0
  if [[ -d "$BACKUP_DIR" ]]; then
    count="$(find "$BACKUP_DIR" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l | tr -d ' ')"
  fi
  [[ "$count" =~ ^[0-9]+$ ]] || count=0
  printf '%s stored' "$count"
}

