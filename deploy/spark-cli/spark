spark_tui_main_config() {
  local dir="$SPARK_TUI_STATE_DIR"
  printf '%s\n' \
    "Deployment:Install update and validate:${dir}/deployment.csv" \
    "System:Host and dependency maintenance:${dir}/system.csv" \
    "Security:Administrative access and TLS:${dir}/security.csv" \
    "Operations:Backups services and manager:${dir}/operations.csv"
}

spark_tui_exit() {
  cleanup >/dev/null 2>&1 || true
  printf '\033[0m\033[2J\033[H'
  exit 0
}

spark_plain_prepare() {
  cleanup >/dev/null 2>&1 || true
  printf '\033[0m\033[2J\033[H'
}

spark_plain_finish() {
  spark_tui_init >/dev/null 2>&1 || true
}

spark_plain_action() {
  local action="$1"
  local rc=0

  set -Eeuo pipefail
  spark_plain_prepare

  case "$action" in
    update) update_spark || rc=$? ;;
    linux) linux_update || rc=$? ;;
    resources) resource_status || rc=$? ;;
    open-admin) open_supabase_admin_access || rc=$? ;;
    close-admin) close_supabase_admin_access || rc=$? ;;
    versions) version_info || rc=$? ;;
    manager-update) self_update || rc=$? ;;
    *) fail "Unknown Spark action: $action"; rc=2 ;;
  esac

  pause || true
  spark_plain_finish
  set +e +u
  return 0
}

spark_plain_install_step() {
  local step="$1"
  set -Eeuo pipefail
  spark_plain_prepare

  if [[ "$step" == "21" ]]; then
    run_all_install || true
  else
    run_install_step "$step" || true
  fi

  pause || true
  spark_tui_write_install_data
  spark_plain_finish
  set +e +u
  return 0
}

spark_tui_write_install_data() {
  local dir="$SPARK_TUI_STATE_DIR"
  local step label status group file
  local labels=(
    "DNS verification"
    "Installation configuration"
    "Packages Docker Node 24"
    "Spark repository"
    "Pinned Supabase source"
    "Supabase secrets"
    "Supabase environment"
    "Edge Functions sync"
    "Provider and worker env"
    "Compose hardening"
    "Validate and start Supabase"
    "Database migrations"
    "Frontend deployment"
    "Nginx bootstrap"
    "TLS certificates"
    "Production Nginx"
    "Local schedulers"
    "TURN and Coturn"
    "Certbot renewal hook"
    "Production firewall"
  )

  for group in foundation platform deployment network; do
    file="${dir}/install-${group}.csv"
    printf 'Step,Status,Component,Command\n' >"$file"
  done

  for step in $(seq 1 20); do
    label="${labels[step-1]}"
    if [[ -f "${STEP_DIR}/${step}.ok" ]]; then
      status="DONE"
    else
      status="PENDING"
    fi

    case "$step" in
      1|2|3|4|5) group="foundation" ;;
      6|7|8|9|10) group="platform" ;;
      11|12|13|14|15|16) group="deployment" ;;
      *) group="network" ;;
    esac

    printf '%02d,%s,%s,spark_plain_install_step %d\n' \
      "$step" "$status" "$label" "$step" >>"${dir}/install-${group}.csv"
  done

  cat >"${dir}/install-automation.csv" <<'EOF'
Step,Status,Component,Command
21,ACTION,Run all installation steps 1 through 20,spark_plain_install_step 21
EOF
}

spark_tui_install_config() {
  local dir="$SPARK_TUI_STATE_DIR"
  printf '%s\n' \
    "Foundation:Host DNS packages and source:${dir}/install-foundation.csv" \
    "Platform:Secrets environment functions and compose:${dir}/install-platform.csv" \
    "Deployment:Runtime migrations frontend and Nginx:${dir}/install-deployment.csv" \
    "Network:Schedulers TURN certificates and firewall:${dir}/install-network.csv" \
    "Automation:Run the complete guided workflow:${dir}/install-automation.csv"
}

