docker_logs_menu() {
  new_log "logs-docker"
  if [[ ! -f "${SUPABASE_ROOT}/docker-compose.yml" ]]; then
    fail "Supabase compose file was not found."
    pause
    return
  fi
  local services service
  mapfile -t services < <(compose config --services)
  title
  menu_section "DOCKER SERVICE LOGS"
  printf '\n'
  printf '  %s\n' "${services[@]}"
  printf '\n'
  read -r -p "Service name for the last 200 log lines (Enter=Back): " service
  [[ -z "$service" ]] && return
  if ! printf '%s\n' "${services[@]}" | grep -Fxq "$service"; then
    fail "Invalid service."
    pause
    return
  fi
  run_report "Logs: ${service}" compose logs --tail=200 --timestamps "$service"
  pause
}

test_menu() {
  while true; do
    title
    menu_section "HEALTH CHECKS & LOGS"
    menu_option "1" "Full Validation" "End-to-end platform validation"
    menu_option "2" "Frontend" "HTTPS and application response"
    menu_option "3" "API / Auth / Functions" "Public API and function routing"
    menu_option "4" "Docker Status" "Container and service state"
    menu_option "5" "Docker Service Logs" "Inspect logs for a selected service"
    menu_option "6" "Nginx Status & Logs" "Web gateway service diagnostics"
    menu_option "7" "Scheduler Status & Logs" "Timers and scheduled function runs"
    menu_option "8" "TURN Status & Logs" "Coturn and STUN validation"
    menu_option "9" "DB / API Exposure Check" "Detect unintended public bindings"
    menu_option "10" "DNS & TLS" "DNS records and certificate validation"
    menu_option "11" "Listening Ports & UFW" "Network listeners and firewall state"
    menu_option "12" "Migration Dry Run" "Preview pending database migrations"
    printf '\n'
    menu_option "0" "Back" "Return to the main control center"
    menu_hint "Detailed command output is stored under /var/log/spark-manager/."
    read -r -p "  Select: " choice
    case "$choice" in
      0) return ;;
      1) new_log "test-full"; run_visible "Full validation" test_full_validation || true; pause ;;
      2) new_log "test-frontend"; run_visible "Frontend" test_frontend || true; pause ;;
      3) new_log "test-api"; run_visible "API" test_api || true; pause ;;
      4) new_log "test-docker"; run_visible "Docker status" compose ps || true; pause ;;
      5) docker_logs_menu ;;
      6)
        new_log "test-nginx"
        run_report "Nginx status" systemctl status nginx --no-pager
        journalctl -u nginx -n 120 --no-pager 2>&1 | tee -a "$CURRENT_LOG" || true
        pause ;;
      7) new_log "test-schedulers"; run_report "Scheduler status" test_schedulers; scheduler_logs; pause ;;
      8)
        new_log "test-turn"
        run_report "TURN test" test_turn
        journalctl -u coturn -n 120 --no-pager 2>&1 | tee -a "$CURRENT_LOG" || true
        pause ;;
      9) new_log "test-exposure"; run_visible "Public exposure check" test_db_exposure || true; pause ;;
      10) new_log "test-dns-ssl"; run_visible "DNS/TLS" test_ssl_dns || true; pause ;;
      11)
        new_log "test-ports-firewall"
        run_report "Listening ports" ss -lntup
        run_report "UFW" ufw status verbose
        pause ;;
      12) new_log "test-migration-dryrun"; run_visible "Migration dry-run" migration_dry_run "$SPARK_ROOT" || true; pause ;;
      *) fail "Invalid option"; sleep 1 ;;
    esac
  done
}

backup_menu() {
  while true; do
    title
    menu_section "BACKUP MANAGEMENT"
    menu_option "1" "Create Manual Backup" "PostgreSQL database + runtime configuration"
    menu_option "2" "List Backups" "Show recent backup directories"
    printf '\n'
    menu_option "0" "Back" "Return to the main control center"
    read -r -p "  Select: " c
    case "$c" in
      0) return ;;
      1)
        new_log "backup-manual"
        if run_visible "Create backup" create_backup manual; then ok "Backup created successfully."; fi
        pause ;;
      2) new_log "backup-list"; run_report "Backups" list_backups; pause ;;
      *) fail "Invalid option"; sleep 1 ;;
    esac
  done
}

npm_menu() {
  while true; do
    title
    menu_section "NODE.JS / NPM / AUDIT"
    menu_option "1" "Show Versions" "Node.js and npm versions"
    menu_option "2" "Update npm" "Update global npm within major version 11"
    menu_option "3" "Install Dependencies" "Run npm ci in the Spark repository"
    menu_option "4" "Full npm Audit" "Audit production and development dependencies"
    menu_option "5" "Production npm Audit" "Audit with --omit=dev"
    menu_option "6" "Outdated Packages" "Show available dependency updates"
    menu_option "7" "Audit Fix Dry Run" "Preview fixes without modifying files"
    printf '\n'
    menu_option "0" "Back" "Return to the main control center"
    read -r -p "  Select: " c
    new_log "npm-maintenance"
    case "$c" in
      0) return ;;
      1) run_report "Versions" bash -c 'node --version; npm --version'; pause ;;
      2) run_visible "Update npm" npm install -g 'npm@^11.6.2' || true; pause ;;
      3) run_visible "npm ci" bash -c "cd '$SPARK_ROOT' && npm ci" || true; pause ;;
      4) run_report "npm audit" bash -c "cd '$SPARK_ROOT' && npm audit"; pause ;;
      5) run_report "npm audit production" bash -c "cd '$SPARK_ROOT' && npm audit --omit=dev"; pause ;;
      6) run_report "npm outdated" bash -c "cd '$SPARK_ROOT' && npm outdated"; pause ;;
      7) run_report "npm audit fix dry-run" bash -c "cd '$SPARK_ROOT' && npm audit fix --dry-run"; pause ;;
      *) fail "Invalid option"; sleep 1 ;;
    esac
  done
}

service_menu() {
  while true; do
    title
    menu_section "SERVICE MANAGEMENT"
    menu_option "1" "Show Service Status" "Nginx, Coturn, Docker and Spark timers"
    menu_option "2" "Restart Functions + Worker" "Recreate Edge Functions and avatar worker"
    menu_option "3" "Reload Nginx" "Validate configuration before reload"
    menu_option "4" "Restart Coturn" "Restart TURN service"
    menu_option "5" "Restart Supabase Stack" "Controlled recreate of all Supabase services"
    menu_option "6" "Restart Scheduler Timers" "Restart all Spark systemd timers"
    printf '\n'
    menu_option "0" "Back" "Return to the main control center"
    read -r -p "  Select: " c
    new_log "service-management"
    case "$c" in
      0) return ;;
      1)
        run_report "Nginx" systemctl status nginx --no-pager
        run_report "Coturn" systemctl status coturn --no-pager
        run_report "Docker" compose ps
        run_report "Timers" systemctl list-timers 'spark-*' --no-pager
        pause ;;
      2) run_visible "Restart Functions + Worker" bash -c "cd '$SUPABASE_ROOT' && docker compose up -d --force-recreate functions avatar-worker" || true; pause ;;
      3) run_visible "Nginx test/reload" bash -c 'nginx -t && systemctl reload nginx' || true; pause ;;
      4) run_visible "Restart Coturn" systemctl restart coturn || true; pause ;;
      5)
        if confirm_word "The entire Supabase stack will be recreated and may cause a brief service interruption." "RESTART"; then
          run_visible "Restart Supabase stack" bash -c "cd '$SUPABASE_ROOT' && docker compose up -d --force-recreate" || true
        fi
        pause ;;
      6)
        run_visible "Restart timers" bash -c 'systemctl restart spark-daily-report.timer spark-minutes-reminder.timer spark-decision-due.timer spark-notification-outbox.timer' || true
        pause ;;
      *) fail "Invalid option"; sleep 1 ;;
    esac
  done
}

certificate_menu() {
  while true; do
    title
    menu_section "TLS CERTIFICATE MANAGEMENT"
    menu_option "1" "Show Certificates" "Display Certbot-managed certificates"
    menu_option "2" "Renewal Dry Run" "Validate the renewal workflow"
    menu_option "3" "Run Certbot Renew" "Execute certificate renewal"
    printf '\n'
    menu_option "0" "Back" "Return to the main control center"
    read -r -p "  Select: " c
    new_log "certificate-management"
    case "$c" in
      0) return ;;
      1) run_report "Certificates" certbot certificates; pause ;;
      2) run_visible "Renewal dry-run" certbot renew --dry-run || true; pause ;;
      3) run_visible "Certbot renew" certbot renew || true; pause ;;
      *) fail "Invalid option"; sleep 1 ;;
    esac
  done
}

case "${1:-}" in
  --version|-V)
    printf 'Spark Server Manager %s\n' "$SPARK_MANAGER_VERSION"
    exit 0
    ;;
  --help|-h)
    cat <<EOF
Usage: spark [option]

Run without an option to open the interactive control center.

  --version       Show Spark Manager version
  --test          Run full validation
  --update        Update Spark application
  --resources     Show server resource usage
EOF
    exit 0
    ;;
  --test)
    title
    new_log "cli-test"
    run_visible "Full validation" test_full_validation
    ;;
  --update)
    update_spark
    ;;
  --resources)
    resource_status
    ;;
  "")
    main_menu
    ;;
  *)
    fail "Unknown option: $1"
    exit 2
    ;;
esac
