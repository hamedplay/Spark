#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'

SPARK_MANAGER_VERSION="1.0.0"
REPO_URL="https://github.com/hamedplay/Spark.git"
RAW_BASE="https://raw.githubusercontent.com/hamedplay/Spark/main/deploy/spark-cli"
SPARK_ROOT="/opt/spark"
SUPABASE_SOURCE="/opt/supabase-source"
SUPABASE_ROOT="/opt/spark-supabase"
CONFIG_DIR="/etc/spark"
MANAGER_CONF="${CONFIG_DIR}/manager.conf"
STATE_DIR="/var/lib/spark-manager"
STEP_DIR="${STATE_DIR}/steps"
LOG_DIR="/var/log/spark-manager"
BACKUP_DIR="/var/backups/spark"
CLI_PATH="/usr/local/bin/spark"

C_RESET=$'\033[0m'
C_GREEN=$'\033[32m'
C_RED=$'\033[31m'
C_YELLOW=$'\033[33m'
C_BLUE=$'\033[34m'
C_CYAN=$'\033[36m'
C_BOLD=$'\033[1m'

CURRENT_LOG=""

if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
  exec sudo -E "$0" "$@"
fi

mkdir -p "$STATE_DIR" "$STEP_DIR" "$LOG_DIR" "$BACKUP_DIR" "$CONFIG_DIR"
chmod 700 "$STATE_DIR" "$STEP_DIR" "$LOG_DIR" "$BACKUP_DIR" "$CONFIG_DIR"


SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
for module in core install-base install-platform-a install-platform-b install-platform-c tests-backup update admin; do
  module_path="${SCRIPT_DIR}/lib/${module}.sh"
  if [[ ! -r "$module_path" ]]; then
    printf 'Spark Manager module missing: %s\n' "$module_path" >&2
    exit 1
  fi
  # shellcheck source=/dev/null
  source "$module_path"
done
unset module module_path

main_menu() {
  while true; do
    title
    printf ' 0) خروج\n'
    printf ' 1) نصب مرحله‌ای سامانه\n'
    printf ' 2) تست، Health Check و Logs\n'
    printf ' 3) Update برنامه از GitHub + Migration + Functions + Frontend\n'
    printf ' 4) Update ابزارهای Linux\n'
    printf ' 5) Node / npm / Audit\n'
    printf ' 6) باز کردن دسترسی مدیریتی Supabase (TLS 8443 / ADMIN_CIDR)\n'
    printf ' 7) بستن دسترسی مدیریتی Supabase\n'
    printf ' 8) نمایش وضعیت منابع سرور\n'
    printf ' 9) Backup Management\n'
    printf '10) Service Management\n'
    printf '11) Certificate Management\n'
    printf '12) Version / Security Info\n'
    printf '13) Update خود Spark Manager\n\n'
    read -r -p "انتخاب: " choice
    case "$choice" in
      0) exit 0 ;;
      1) install_menu ;;
      2) test_menu ;;
      3) update_spark || true; pause ;;
      4) linux_update || true; pause ;;
      5) npm_menu ;;
      6) open_supabase_admin_access || true; pause ;;
      7) close_supabase_admin_access || true; pause ;;
      8) resource_status; pause ;;
      9) backup_menu ;;
      10) service_menu ;;
      11) certificate_menu ;;
      12) version_info; pause ;;
      13) self_update || true; pause ;;
      *) fail "گزینه نامعتبر"; sleep 1 ;;
    esac
  done
}

case "${1:-}" in
  --version|-V)
    printf 'Spark Server Manager %s\n' "$SPARK_MANAGER_VERSION"
    exit 0
    ;;
  --help|-h)
    cat <<EOF
Usage: spark [option]

بدون option منوی تعاملی باز می‌شود.

  --version       نمایش نسخه
  --test          اجرای Validation کامل
  --update        اجرای Update برنامه
  --resources     نمایش وضعیت منابع
EOF
    exit 0
    ;;
  --test)
    title
    new_log "cli-test"
    run_visible "Validation کامل" test_full_validation
    ;;
  --update)
    update_spark
    ;;
  --resources)
    resource_status
    ;;
  "")
    main_menu
    ;;
  *)
    fail "Option ناشناخته: $1"
    exit 2
    ;;
esac
