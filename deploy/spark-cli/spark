#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'

SCRIPT_DIR="$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
for module in core install-base install-platform-a install-platform-b install-platform-c tests-backup update admin cleanup repair-override env-modern runtime-fixes studio-session install-livekit; do
  module_path="${SCRIPT_DIR}/lib/${module}.sh"
  [[ -f "$module_path" ]] || { echo "Missing Spark Manager module: $module_path" >&2; exit 1; }
  # shellcheck source=/dev/null
  source "$module_path"
done
unset module module_path

# Final installation contract: version-agnostic, host/domain-agnostic.
source "${SCRIPT_DIR}/lib/installation-universal.sh"

install_manager_from_dir() {
  local source_dir="$1"
  local target="${MANAGER_LIB_DIR}.new.$$"
  local module
  require_root
  [[ -d "$source_dir" ]] || { fail "Manager source directory not found: $source_dir"; return 1; }
  rm -rf "$target"
  install -d -m 0755 "$target/lib" "$target/livekit"
  install -m 0755 "$source_dir/spark" "$target/spark"
  install -m 0755 "$source_dir/spark-airgap" "$target/spark-airgap"
  install -m 0644 "$source_dir/spark-ui.py" "$target/spark-ui.py"
  install -m 0644 "$source_dir/spark-ui-core.py" "$target/spark-ui-core.py"
  install -m 0644 "$source_dir/spark-ui-base.py" "$target/spark-ui-base.py"
  for module in core install-base install-platform-a install-platform-b install-platform-c tests-backup update admin cleanup repair-override env-modern runtime-fixes studio-session install-livekit installation-universal; do
    install -m 0644 "$source_dir/lib/${module}.sh" "$target/lib/${module}.sh"
  done
  rsync -a --delete "$source_dir/livekit/" "$target/livekit/"
  rm -rf "$MANAGER_LIB_DIR"
  mv "$target" "$MANAGER_LIB_DIR"
  ln -sfn "$MANAGER_LIB_DIR/spark" /usr/local/bin/spark
  ln -sfn "$MANAGER_LIB_DIR/spark-airgap" /usr/local/bin/spark-airgap
}

self_update() {
  title
  new_log "manager-update"
  require_root
  local tmp_repo
  tmp_repo="$(mktemp -d /tmp/spark-manager-update.XXXXXX)"
  trap 'rm -rf "$tmp_repo"' RETURN
  run_visible "Download latest Spark Manager" git clone --depth 1 --single-branch --branch main --no-tags --progress "$REPO_URL" "$tmp_repo" || return 1
  install_manager_from_dir "$tmp_repo/deploy/spark-cli" || return 1
  ok "Spark Manager updated from Internet."
}

version_info() {
  title
  new_log "version-info"
  printf 'Spark Server Manager: %s\n' "$SPARK_MANAGER_VERSION"
  printf 'OS: %s\n' "$(lsb_release -ds 2>/dev/null || . /etc/os-release && echo "$PRETTY_NAME")"
  printf 'Kernel: %s\n' "$(uname -r)"
  docker --version 2>/dev/null || true
  docker compose version 2>/dev/null || true
  node --version 2>/dev/null || true
  npm --version 2>/dev/null || true
  nginx -v 2>&1 || true
  certbot --version 2>/dev/null || true
}

spark_backend_prepare() {
  ensure_dirs
  CURRENT_LOG="${LOG_DIR}/backend-$(date +%Y%m%d-%H%M%S)-$$-${RANDOM}.log"
  touch "$CURRENT_LOG"
  chmod 0600 "$CURRENT_LOG"
}

spark_backend_dispatch_inner() {
  local action="$1"
  shift || true
  case "$action" in
    install-01) install_step_1 ;;
    install-02) install_step_2 ;;
    install-03) install_step_3 ;;
    install-04) install_step_4 ;;
    install-05) install_step_5 ;;
    install-06) install_step_6 ;;
    install-07) install_step_7 ;;
    install-08) install_step_8 ;;
    install-09) install_step_9 ;;
    install-10) install_step_10 ;;
    install-11) install_step_11 ;;
    install-12) install_step_12 ;;
    install-13) install_step_13 ;;
    install-14) install_step_14 ;;
    install-15) install_step_15 ;;
    install-16) install_step_16 ;;
    install-17) install_step_17 ;;
    install-18) install_step_18 ;;
    install-19) install_step_19 ;;
    install-20) install_step_20 ;;
    install-21) install_step_21 ;;
    install-22) install_step_22 ;;

    airgap-build) airgap_build_bundle ;;
    airgap-validate) airgap_validate_interactive ;;
    airgap-import) airgap_import_bundle "${1:-}" ;;
    airgap-step) airgap_install_one_step "${1:-}" ;;
    airgap-install-all) airgap_install_all ;;
    airgap-status) airgap_status ;;

    diagnostic-full) new_log "diagnostic-full"; run_visible "Full validation" test_full_validation ;;
    diagnostic-supabase) new_log "test-supabase"; run_visible "Supabase services" test_supabase_health ;;
    diagnostic-nginx) new_log "test-nginx"; run_visible "Nginx" test_nginx_production ;;
    diagnostic-schedulers)
      new_log "test-schedulers"
      run_report "Scheduler status" test_schedulers
      scheduler_logs
      ;;
    diagnostic-turn)
      new_log "test-turn"
      run_report "TURN test" test_turn
      journalctl -u coturn -n 160 --no-pager 2>&1 | tee -a "$CURRENT_LOG" || true
      ;;
    diagnostic-livekit) new_log "test-livekit"; run_visible "LiveKit media platform" test_livekit_full_validation ;;
    diagnostic-exposure) new_log "test-exposure"; run_visible "DB/API public exposure" test_db_exposure ;;
    diagnostic-dns-ssl) new_log "test-dns-ssl"; run_visible "DNS / SSL" test_ssl_dns ;;
    diagnostic-ports)
      new_log "test-ports-firewall"
      run_report "Listening ports" ss -lntup
      run_report "UFW" ufw status verbose
      ;;

    app-update) update_spark ;;
    app-build-offline-update) application_build_offline_update ;;
    app-update-offline) application_update_offline ;;
    app-npm-update) application_npm_update ;;
    app-node-update) application_node_update ;;
    app-packages-update) application_packages_update ;;
    app-npm-outdated) application_npm_outdated ;;
    app-npm-audit-production) application_npm_audit_production ;;
    app-npm-audit-all) application_npm_audit_all ;;
    app-npm-list) application_npm_list ;;
    app-npm-doctor) application_npm_doctor ;;
    app-nginx-gzip) application_optimize_nginx_gzip ;;
    app-active-version) application_active_version ;;

    database-update-supabase) spark_database_update_supabase ;;

    linux-update) linux_update ;;
    resources) resource_status ;;
    linux-network) linux_system_network ;;
    linux-firewall) linux_system_firewall ;;
    linux-version) linux_system_version ;;
    linux-package-version) linux_system_package_versions ;;
    linux-reboot) linux_system_reboot ;;
    linux-history-delete) linux_system_history_delete ;;
    linux-log-delete) linux_system_log_delete ;;
    linux-cache-delete) linux_system_cache_delete ;;
    linux-user-active) linux_system_active_users ;;
    version-info) version_info ;;

    npm-versions) new_log "npm-versions"; run_report "Node / npm versions" bash -c 'node --version; npm --version' ;;
    npm-update) new_log "npm-update"; run_visible "Update npm 12.2" npm install -g 'npm@12.2.0' ;;
    npm-ci) new_log "npm-ci"; run_visible "npm ci" bash -c "cd '$SPARK_ROOT' && npm ci" ;;
    npm-audit) new_log "npm-audit"; run_report "npm audit" bash -c "cd '$SPARK_ROOT' && npm audit" ;;
    npm-audit-prod) new_log "npm-audit-prod"; run_report "npm audit --omit=dev" bash -c "cd '$SPARK_ROOT' && npm audit --omit=dev" ;;
    npm-outdated) new_log "npm-outdated"; run_report "npm outdated" bash -c "cd '$SPARK_ROOT' && npm outdated" ;;
    npm-fix-dry) new_log "npm-fix-dry"; run_report "npm audit fix --dry-run" bash -c "cd '$SPARK_ROOT' && npm audit fix --dry-run" ;;

    security-db-info) show_database_connection_info ;;
    security-db-test) new_log "database-login-test"; run_visible "PostgreSQL login through local Supavisor" database_pooler_login_test 5433 ;;
    security-db-open) new_log "database-access-open"; open_database_external_access ;;
    security-db-close) close_database_external_access ;;
    security-studio-info) show_studio_connection_info ;;
    security-studio-open) open_supabase_studio_access ;;
    security-studio-close) close_supabase_studio_access ;;
    security-report) security_status_report ;;
    security-account-unlock) new_log "account-unlock"; spark_account_unlock ;;

    admin-open) open_supabase_admin_access ;;
    admin-close) close_supabase_admin_access ;;

    cleanup-database) cleanup_database_data ;;
    cleanup-supabase) cleanup_supabase_runtime ;;
    cleanup-frontend) cleanup_frontend_deploy ;;
    cleanup-source) cleanup_spark_source ;;
    cleanup-logs) cleanup_manager_logs ;;
    cleanup-backups) cleanup_backups ;;
    cleanup-history) cleanup_install_history ;;
    cleanup-livekit) cleanup_livekit_runtime ;;
    cleanup-full) cleanup_full_project ;;
    cleanup-manager) cleanup_uninstall_manager ;;

    service-status)
      new_log "service-status"
      run_report "Nginx" systemctl status nginx --no-pager
      run_report "Coturn (legacy/fallback)" systemctl status coturn --no-pager
      if [[ -f "$LIVEKIT_ENV" ]]; then run_report "LiveKit" livekit_compose ps; fi
      run_report "Docker" compose ps
      run_report "Timers" systemctl list-timers 'spark-*' --no-pager
      ;;
    service-functions) new_log "service-functions"; run_visible "Restart Functions + Worker" bash -c "cd '$SUPABASE_ROOT' && docker compose up -d --force-recreate functions avatar-worker" ;;
    service-nginx) new_log "service-nginx"; run_visible "Nginx test/reload" bash -c 'nginx -t && systemctl reload nginx' ;;
    service-coturn) new_log "service-coturn"; run_visible "Restart Coturn" systemctl restart coturn ;;
    service-livekit) livekit_restart ;;
    service-supabase)
      new_log "service-supabase"
      if confirm_word "The complete Supabase stack will be recreated/restarted and may briefly interrupt service." "RESTART"; then
        run_visible "Restart Supabase stack" bash -c "cd '$SUPABASE_ROOT' && docker compose up -d --force-recreate"
      else
        warn "Cancelled."
      fi
      ;;
    service-timers) new_log "service-timers"; run_visible "Restart schedulers" bash -c 'systemctl restart spark-daily-report.timer spark-minutes-reminder.timer spark-decision-due.timer spark-notification-outbox.timer' ;;

    cert-list) new_log "cert-list"; run_report "Certificates" certbot certificates ;;
    cert-dry-run) new_log "cert-dry-run"; run_visible "Certificate renewal dry-run" certbot renew --dry-run ;;
    cert-renew) new_log "cert-renew"; run_visible "Certbot renew" certbot renew ;;

    backup-create)
      new_log "backup-manual"
      run_visible "Create DB + config backup" create_backup manual
      ;;
    backup-restore-plain)
      new_log "database-restore-plain"
      restore_plain_database_interactive
      ;;
    backup-list) new_log "backup-list"; run_report "Backups" list_backups ;;

    manager-update) self_update ;;
    *) fail "Unknown Spark backend action: $action"; return 2 ;;
  esac
}

spark_backend_action() {
  local action="${1:-}"
  shift || true
  [[ -n "$action" ]] || { printf 'Backend action is required.\n' >&2; return 2; }
  spark_backend_prepare
  printf 'SPARK_ACTION_BEGIN %s %s\n' "$action" "$(date -Is)"
  local rc=0
  set +e
  ( set -Eeuo pipefail; spark_backend_dispatch_inner "$action" "$@" )
  rc=$?
  set -e
  printf 'SPARK_ACTION_END %s rc=%d %s\n' "$action" "$rc" "$(date -Is)"
  return "$rc"
}

spark_backend_list_docker_services() {
  local services=()
  mapfile -t services < <(docker ps --format '{{.Names}}' 2>/dev/null | sort)
  printf '%s\n' "${services[@]}"
}

spark_backend_list_actions() {
  python3 "$SCRIPT_DIR/spark-ui.py" --json-actions
}

if [[ "${1:-}" == "--backend-action" ]]; then
  shift
  spark_backend_action "$@"
  exit $?
fi
if [[ "${1:-}" == "--backend-actions-json" ]]; then
  spark_backend_list_actions
  exit 0
fi
if [[ "${1:-}" == "--backend-docker-services" ]]; then
  spark_backend_list_docker_services
  exit 0
fi
if [[ "${1:-}" == "--ui-self-test" ]]; then
  python3 "$SCRIPT_DIR/spark-ui.py" --self-test
  exit $?
fi
if [[ "${1:-}" == "--version" ]]; then
  printf 'Spark Server Manager %s\n' "$SPARK_MANAGER_VERSION"
  exit 0
fi

exec python3 "$SCRIPT_DIR/spark-ui.py" "$@"
