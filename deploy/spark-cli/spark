  welcome_screen
  while true; do
    title

    menu_section "DEPLOYMENT"
    menu_option "1" "Install / Configure Spark" "Guided 20-step single-host deployment"
    menu_option "2" "Health Checks & Logs" "Validate services and inspect runtime logs"
    menu_option "3" "Update Spark Application" "GitHub, migrations, functions and frontend"

    menu_section "SYSTEM"
    menu_option "4" "Update Linux Packages" "APT packages and reboot status"
    menu_option "5" "Node.js / npm / Audit" "Dependencies, audit and maintenance"
    menu_option "8" "Resource Monitor" "CPU, memory, disk, processes and containers"

    menu_section "SECURITY & ACCESS"
    menu_option "6" "Open Supabase Admin Access" "TLS 8443 restricted to ADMIN_CIDR"
    menu_option "7" "Close Supabase Admin Access" "Remove the temporary admin gateway"
    menu_option "11" "TLS Certificate Management" "Inspect and renew certificates"

    menu_section "OPERATIONS"
    menu_option "9" "Backup Management" "Database and configuration backups"
    menu_option "10" "Service Management" "Status, restart and reload operations"
    menu_option "12" "Version & Security Info" "Runtime and deployment version details"
    menu_option "13" "Update Spark Manager" "Refresh this management console"

    printf '\n'
    menu_option "0" "Exit" "Close Spark Server Manager"
    menu_hint "Select an option and press Enter."
    read -r -p "  Select: " choice
    case "$choice" in
      0) exit 0 ;;
      1) install_menu ;;
      2) test_menu ;;
      3) update_spark || true; pause ;;
      4) linux_update || true; pause ;;
      5) npm_menu ;;
      6) open_supabase_admin_access || true; pause ;;
      7) close_supabase_admin_access || true; pause ;;
      8) resource_status; pause ;;
      9) backup_menu ;;
      10) service_menu ;;
      11) certificate_menu ;;
      12) version_info; pause ;;
