        journalctl -u nginx -n 120 --no-pager 2>&1 | tee -a "$CURRENT_LOG" || true
        ;;
      07) new_log "test-schedulers"; run_report "Scheduler status" test_schedulers; scheduler_logs ;;
      08)
        new_log "test-turn"
        run_report "TURN test" test_turn
        journalctl -u coturn -n 120 --no-pager 2>&1 | tee -a "$CURRENT_LOG" || true
        ;;
      09) new_log "test-exposure"; run_visible "Public exposure check" test_db_exposure || true ;;
      10) new_log "test-dns-ssl"; run_visible "DNS/TLS" test_ssl_dns || true ;;
      11)
        new_log "test-ports-firewall"
        run_report "Listening ports" ss -lntup
        run_report "UFW" ufw status verbose
        ;;
      12) new_log "test-migration-dryrun"; run_visible "Migration dry-run" migration_dry_run "$SPARK_ROOT" || true ;;
    esac
    pause || true
    spark_plain_finish
  done
}

docker_logs_menu() {
  spark_tui_init || return 1
  new_log "logs-docker"
  if [[ ! -f "${SUPABASE_ROOT}/docker-compose.yml" ]]; then
    spark_plain_prepare
    fail "Supabase compose file was not found."
    pause || true
    spark_plain_finish
    return 0
  fi

  local services choice
  mapfile -t services < <(compose config --services)
  ((${#services[@]})) || return 0

  BACKTITLE="⚡ SPARK · DOCKER LOGS"
  export BACKTITLE
  choice="$(spark_tui_pick "DOCKER SERVICE LOGS" \
    "Select a service to display its last 200 log lines" 1 "${services[@]}")" || return 0

  spark_plain_prepare
  run_report "Logs: ${choice}" compose logs --tail=200 --timestamps "$choice"
  pause || true
  spark_plain_finish
}

