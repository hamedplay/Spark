#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'
SPARK_ROOT=/opt/spark

SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  SOURCE_DIR="$(cd -P -- "$(dirname -- "$SOURCE")" >/dev/null 2>&1 && pwd)"
  TARGET="$(readlink -- "$SOURCE")"
  if [[ "$TARGET" == /* ]]; then
    SOURCE="$TARGET"
  else
    SOURCE="${SOURCE_DIR}/${TARGET}"
  fi
done
SCRIPT_DIR="$(cd -P -- "$(dirname -- "$SOURCE")/.." >/dev/null 2>&1 && pwd)"
unset SOURCE SOURCE_DIR TARGET

for module in core airgap-build airgap-manager; do
  path="$SCRIPT_DIR/lib/$module.sh"
  [[ -r "$path" ]] || { echo "Spark Manager Air-Gap module missing: $path" >&2; exit 1; }
  source "$path"
done
unset module path

spark_airgap_sync_source_main() {
  local branch local_head remote_head origin_url
  [[ -d "${SPARK_ROOT}/.git" ]] || { fail "Spark source repository is required at ${SPARK_ROOT}."; return 1; }
  branch="$(command git -C "$SPARK_ROOT" branch --show-current 2>/dev/null || true)"
  [[ "$branch" == main ]] || { fail "Spark source must be on branch main before building a Manager Air-Gap bundle."; return 1; }
  [[ -z "$(command git -C "$SPARK_ROOT" status --porcelain 2>/dev/null)" ]] || { fail "Spark source has uncommitted changes; refusing Manager bundle build."; return 1; }
  origin_url="$(command git -C "$SPARK_ROOT" remote get-url origin 2>/dev/null || true)"
  [[ "$origin_url" == "https://github.com/hamedplay/Spark.git" || "$origin_url" == "git@github.com:hamedplay/Spark.git" ]] || { fail "Unexpected Spark origin remote: ${origin_url:-missing}"; return 1; }
  GIT_TERMINAL_PROMPT=0 command git -c http.version=HTTP/1.1 -C "$SPARK_ROOT" fetch --prune origin main || { fail "Unable to fetch Spark main."; return 1; }
  local_head="$(command git -C "$SPARK_ROOT" rev-parse HEAD)"
  remote_head="$(command git -C "$SPARK_ROOT" rev-parse FETCH_HEAD)"
  if [[ "$local_head" != "$remote_head" ]]; then
    command git -C "$SPARK_ROOT" merge-base --is-ancestor "$local_head" "$remote_head" || { fail "Local Spark main diverged from origin/main."; return 1; }
    command git -C "$SPARK_ROOT" merge --ff-only "$remote_head" >/dev/null || { fail "Unable to fast-forward Spark main."; return 1; }
  fi
  ok "Spark source revision: ${remote_head:0:12}"
}

dispatch_backend() {
  local action="${1:-}"; shift || true
  case "$action" in
    manager-airgap-build) spark_manager_airgap_build "${1:-$PWD}" "${2:-}" ;;
    manager-airgap-install-environment) spark_manager_airgap_install_environment "${1:-}" "${2:-$(spark_manager_airgap_profile_path)}" ;;
    manager-airgap-verify-revisions|manager-airgap-status) spark_manager_airgap_verify_revisions "${1:-$(spark_manager_airgap_profile_path)}" "${2:-$(spark_manager_airgap_revision)}" ;;
    *) echo "Unknown Manager Air-Gap backend action: $action" >&2; return 2 ;;
  esac
}

case "${1:-}" in
  --backend-action) shift; dispatch_backend "$@" ;;
  --build) shift; spark_manager_airgap_build "${1:-$PWD}" "${2:-}" ;;
  --install-environment) shift; spark_manager_airgap_install_environment "${1:-}" "${2:-$(spark_manager_airgap_profile_path)}" ;;
  --verify-revisions|--status) shift; spark_manager_airgap_verify_revisions "${1:-$(spark_manager_airgap_profile_path)}" "${2:-$(spark_manager_airgap_revision)}" ;;
  --version|-V) printf 'Spark Manager Air-Gap Control 1\n' ;;
  --help|-h|"") cat <<'EOF'
Usage: spark-manager-airgap [option]
  --build [output-dir] [ubuntu]       Build exact-revision Manager-only offline bundle
  --install-environment [bundle]      Install/update Manager on configured environment nodes
  --verify-revisions [profile]        Verify all node Manager revisions against Jump
  --status [profile]                  Alias for revision/status verification
EOF
    ;;
  *) echo "Unknown option: $1" >&2; exit 2 ;;
esac
