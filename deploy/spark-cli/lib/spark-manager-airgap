#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'

SPARK_MANAGER_VERSION="4.0.0"
SPARK_ROOT="/opt/spark"
CONFIG_DIR="/etc/spark"
MANAGER_CONF="${CONFIG_DIR}/manager.conf"
STATE_DIR="/var/lib/spark-manager"
STEP_DIR="${STATE_DIR}/steps"
LOG_DIR="/var/log/spark-manager"
BACKUP_DIR="/var/backups/spark"
CURRENT_LOG=""

C_RESET=$'\033[0m'
C_GREEN=$'\033[32m'
C_RED=$'\033[31m'
C_YELLOW=$'\033[33m'
C_BLUE=$'\033[34m'
C_CYAN=$'\033[36m'
C_WHITE=$'\033[37m'
C_BOLD=$'\033[1m'
C_DIM=$'\033[2m'

SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  SOURCE_DIR="$(cd -P -- "$(dirname -- "$SOURCE")" >/dev/null 2>&1 && pwd)"
  TARGET="$(readlink -- "$SOURCE")"
  if [[ "$TARGET" == /* ]]; then
    SOURCE="$TARGET"
  else
    SOURCE="${SOURCE_DIR}/${TARGET}"
  fi
done
SCRIPT_DIR="$(cd -P -- "$(dirname -- "$SOURCE")/.." >/dev/null 2>&1 && pwd)"
unset SOURCE SOURCE_DIR TARGET

mkdir -p "$STATE_DIR" "$STEP_DIR" "$LOG_DIR" "$BACKUP_DIR" "$CONFIG_DIR"
chmod 700 "$STATE_DIR" "$STEP_DIR" "$LOG_DIR" "$BACKUP_DIR" "$CONFIG_DIR"

# airgap-full-source is intentionally sourced last. It overrides the legacy
# Git-bundle builder with the exact-revision Spark-main.zip implementation.
for module in core airgap-build airgap-manager airgap-full-source; do
  path="$SCRIPT_DIR/lib/$module.sh"
  [[ -r "$path" ]] || { echo "Spark Manager Air-Gap module missing: $path" >&2; exit 1; }
  source "$path"
done
unset module path

spark_airgap_sync_source_main() {
  local remote_head shallow
  [[ -d "${SPARK_ROOT}/.git" ]] || { fail "Spark source repository is required at ${SPARK_ROOT} on the connected builder."; return 1; }

  shallow="$(command git -C "$SPARK_ROOT" rev-parse --is-shallow-repository 2>/dev/null || printf false)"
  if [[ "$shallow" == "true" ]]; then
    GIT_TERMINAL_PROMPT=0 command git -c http.version=HTTP/1.1 -C "$SPARK_ROOT" fetch --prune --unshallow origin main || {
      fail "Unable to unshallow Spark main history."
      return 1
    }
  else
    GIT_TERMINAL_PROMPT=0 command git -c http.version=HTTP/1.1 -C "$SPARK_ROOT" fetch --prune origin main || {
      fail "Unable to fetch Spark main."
      return 1
    }
  fi

  remote_head="$(command git -C "$SPARK_ROOT" rev-parse FETCH_HEAD)"
  command git -C "$SPARK_ROOT" rev-list --objects "$remote_head" >/dev/null || {
    fail "Spark main history is incomplete on the connected builder."
    return 1
  }
  printf '%s\n' "$remote_head"
}

dispatch_backend() {
  local action="${1:-}"; shift || true
  case "$action" in
    manager-airgap-build) spark_manager_airgap_build "${1:-$PWD}" "${2:-}" ;;
    manager-airgap-install-environment) spark_manager_airgap_install_environment "${1:-}" "${2:-$(spark_manager_airgap_profile_path)}" ;;
    manager-airgap-verify-revisions|manager-airgap-status) spark_manager_airgap_status "${1:-$(spark_manager_airgap_profile_path)}" ;;
    *) echo "Unknown Manager Air-Gap backend action: $action" >&2; return 2 ;;
  esac
}

case "${1:-}" in
  --backend-action) shift; dispatch_backend "$@" ;;
  --build) shift; spark_manager_airgap_build "${1:-$PWD}" "${2:-}" ;;
  --install-environment) shift; spark_manager_airgap_install_environment "${1:-}" "${2:-$(spark_manager_airgap_profile_path)}" ;;
  --verify-revisions|--status) shift; spark_manager_airgap_status "${1:-$(spark_manager_airgap_profile_path)}" ;;
  --version|-V) printf 'Spark Manager Air-Gap Control 1\n' ;;
  --help|-h|"") cat <<'EOF'
Usage: spark-manager-airgap [option]
  --build [output-dir] [ubuntu]       Build exact-revision Spark-main.zip + Manager offline bundle
  --install-environment [bundle]      Install/update complete /opt/spark snapshot + Manager without target network access
  --verify-revisions [profile]        Legacy alias for Manager node readiness
  --status [profile]                  Show Manager node reachability/readiness
EOF
    ;;
  *) echo "Unknown option: $1" >&2; exit 2 ;;
esac
