#!/usr/bin/env bash
set -Eeuo pipefail
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  DIR="$(cd -P -- "$(dirname -- "$SOURCE")" && pwd)"
  LINK="$(readlink -- "$SOURCE")"
  [[ "$LINK" == /* ]] && SOURCE="$LINK" || SOURCE="$DIR/$LINK"
done
SCRIPT_DIR="$(cd -P -- "$(dirname -- "$SOURCE")" && pwd)"
exec "$SCRIPT_DIR/spark-manager-airgap" --build "$@"
