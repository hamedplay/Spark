# Environment variables for the notification outbox scheduler.
# Install: sudo cp deploy/notification-outbox.env.example /etc/myapp/notification-outbox.env
# Then edit the values and set the secret.

NOTIFICATION_OUTBOX_CRON_SECRET=replace-with-a-strong-random-secret
NOTIFICATION_OUTBOX_ENDPOINT=https://your-project.supabase.co/functions/v1/process-notification-outbox
