# Environment variables for the minutes reminder scheduler.
# Install: sudo cp deploy/minutes-reminder.env.example /etc/myapp/minutes-reminder.env
# Then edit the values and set the secret.
#
# The cron secret must match the MINUTES_REMINDER_CRON_SECRET env var
# configured on the Supabase Edge Function.
#
# The endpoint is the URL of the process-minutes-reminders edge function.

MINUTES_REMINDER_CRON_SECRET=replace-with-a-strong-random-secret
MINUTES_REMINDER_ENDPOINT=https://your-project.supabase.co/functions/v1/process-minutes-reminders
