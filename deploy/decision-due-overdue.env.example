# Environment variables for the decision due/overdue scheduler.
# Install: sudo cp deploy/decision-due-overdue.env.example /etc/myapp/decision-due-overdue.env

DECISION_DUE_CRON_SECRET=replace-with-a-strong-random-secret
DECISION_DUE_ENDPOINT=https://your-project.supabase.co/functions/v1/process-decision-due-overdue
