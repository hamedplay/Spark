# Phase 24 runtime integration — placeholders only.
# Copy to a local .env file (ignored by Git) and export the values before run.

PHASE24_SUPABASE_URL=https://api.example.internal
PHASE24_ANON_KEY=replace-with-test-anon-key
PHASE24_SERVICE_ROLE_KEY=replace-with-test-service-role-key
PHASE24_HOST_ACCESS_TOKEN=replace-with-host-access-token
PHASE24_PARTICIPANT_ACCESS_TOKEN=replace-with-participant-access-token
PHASE24_ROOM_ID=replace-with-dedicated-test-room-uuid
PHASE24_PARTICIPANT_USER_ID=replace-with-test-participant-user-uuid

# Set to 1 only in a dedicated E2E/integration room where recording side
# effects and object-storage cleanup are acceptable.
PHASE24_ENABLE_RECORDING=0
