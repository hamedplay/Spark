# Phase 24 browser E2E — placeholders only.
PHASE24_CONFERENCE_URL=https://app.example.internal/?conference=AAA-BBB-CCC
PHASE24_HOST_NAME=Phase24 Host
PHASE24_PARTICIPANT_NAME=Phase24 Participant
PHASE24_HOST_STORAGE_STATE=/secure/path/host.storage-state.json
PHASE24_PARTICIPANT_STORAGE_STATE=/secure/path/participant.storage-state.json

# Full Definition-of-Done run should use a dedicated SCHEDULED/WAITING room
# and set both values to 1.
PHASE24_E2E_REQUIRE_COUNTDOWN=1
PHASE24_E2E_RECORDING=1
PHASE24_E2E_SCREEN_SHARE=1
